<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <AssemblyName>HubnerExt</AssemblyName>
        <RootNamespace>HubnerExt</RootNamespace>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
        <McpDll Condition="'$(McpDll)'==''">$(MSBuildProjectDirectory)/../out/ValheimMCP.dll</McpDll>
        <LibDir Condition="'$(LibDir)'==''">$(MSBuildProjectDirectory)/lib</LibDir>
        <OutputPath>$(MSBuildProjectDirectory)/../out/server/</OutputPath>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <DefineConstants>$(DefineConstants);SERVER</DefineConstants>
        <BaseIntermediateOutputPath>obj-server/</BaseIntermediateOutputPath>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Common.cs" /><Compile Include="Shared.cs" /><Compile Include="Plans.cs" /><Compile Include="Audit.cs" /><Compile Include="InsightShared.cs" /><Compile Include="VirtualPeers.cs" /><Compile Include="ClientTools.cs" /><Compile Include="Geo.cs" /><Compile Include="Reg.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"><PrivateAssets>all</PrivateAssets></PackageReference>
        <Reference Include="ValheimMCP"><HintPath>$(McpDll)</HintPath><Private>false</Private></Reference>
        <Reference Include="0Harmony"><HintPath>$(LibDir)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="BepInEx"><HintPath>$(LibDir)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="assembly_valheim"><HintPath>$(LibDir)/Managed/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="assembly_utils"><HintPath>$(LibDir)/Managed/assembly_utils.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine"><HintPath>$(LibDir)/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(LibDir)/Managed/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(LibDir)/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(LibDir)/Managed/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    </ItemGroup>
</Project>
