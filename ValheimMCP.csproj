<Project Sdk="Microsoft.NET.Sdk">
    <!-- Hubner fork of myrcutio/ValheimMCP (MIT, see LICENSE): adds a tool registry and a hot-reloadable
         extension host (BepInEx/hubner-ext/*.dll). Game and BepInEx assemblies are read from ext/lib (not committed):
         dotnet build -c Release ValheimMCP.csproj   (override with -p:LibDir=/path/to/lib; output goes to ./out/) -->
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <AssemblyName>ValheimMCP</AssemblyName>
        <RootNamespace>ValheimMCP</RootNamespace>
        <!-- SINGLE SOURCE OF TRUTH for the core's identity/version: flows into PluginInfo and the assembly version. -->
        <Version>0.4.0</Version>
        <BepInExPluginGuid>com.valheimmcp.server</BepInExPluginGuid>
        <BepInExPluginName>Valheim MCP Server (Hubner)</BepInExPluginName>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
        <LibDir Condition="'$(LibDir)'==''">$(MSBuildProjectDirectory)/ext/lib</LibDir>
        <OutputPath>$(MSBuildProjectDirectory)/out/</OutputPath>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="src/ValheimMCP/**/*.cs" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"><PrivateAssets>all</PrivateAssets></PackageReference>
        <Reference Include="BepInEx"><HintPath>$(LibDir)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="0Harmony"><HintPath>$(LibDir)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="assembly_valheim"><HintPath>$(LibDir)/Managed/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine"><HintPath>$(LibDir)/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(LibDir)/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(LibDir)/Managed/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    </ItemGroup>
    <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile" Inputs="$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)PluginInfo.g.cs">
        <PropertyGroup>
            <PluginInfoContent>// &lt;auto-generated/&gt;
namespace ValheimMCP
{
    internal static class PluginInfo
    {
        public const string Guid = "$(BepInExPluginGuid)"%3B
        public const string Name = "$(BepInExPluginName)"%3B
        public const string Version = "$(Version)"%3B
    }
}
</PluginInfoContent>
        </PropertyGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)PluginInfo.g.cs" Lines="$(PluginInfoContent)" Overwrite="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)PluginInfo.g.cs" />
        </ItemGroup>
    </Target>
</Project>
